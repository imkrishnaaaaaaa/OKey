rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Per-user vault container. Nothing outside a user's own subtree is
    // readable or writable by anyone, ever.
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'createdAt', 'displayName']);
      allow update: if isOwner(uid);
      allow delete: if false; // account deletion handled out-of-band

      // vault holds the meta and settings docs. The PIN wrap (wrappedMaster)
      // must never be stored here: a 4-digit PIN can be guessed offline.
      match /vault/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && !request.resource.data.keys().hasAny(['wrappedMaster']);
      }

      // One doc per entry. Payload is ciphertext, capped at 100 KB.
      match /entries/{entryId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.get('payload', '').size() <= 102400;
      }
    }
  }
}
