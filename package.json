{
  "name": "okey",
  "version": "1.0.0",
  "description": "OKey — A zero-knowledge password & 2FA manager. Chrome extension and PWA, end-to-end encrypted, synced through your own Firebase account.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:extension": "node build.mjs extension",
    "build:pwa": "node build.mjs pwa",
    "watch": "node build.mjs --watch",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "password-manager",
    "chrome-extension",
    "pwa",
    "encryption",
    "zero-knowledge",
    "argon2",
    "totp",
    "okey"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@scure/bip39": "^1.6.0",
    "firebase": "^11.10.0",
    "hash-wasm": "^4.12.0",
    "tldts": "^7.4.19"
  }
